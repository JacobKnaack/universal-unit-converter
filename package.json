{
  "name": "universal-unit-converter",
  "version": "1.0.0",
  "description": "Converts any unit to a specified conversion unit",
  "main": "content.js",
  "scripts": {
    "test": "vitest",
    "build": "vite build && vite build -c vite.content.config.mjs",
    "dev:main": "vite build --watch --config vite.config.mjs",
    "dev:content": "vite build --watch --config vite.content.config.mjs",
    "dev": "cross-env NODE_ENV=dev concurrently -k \"npm run dev:main\" \"npm run dev:content\"",
    "serve": "http-server -p 8080 -c-1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^3.2.6"
  }
}
