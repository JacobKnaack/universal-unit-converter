{
  "manifest_version": 3,
  "name": "Universal Unit Converter",
  "version": "1.0.0",
  "description": "Converts units on webpages and provides a popup converter.",
  "permissions": ["storage"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Unit Converter"
  },

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
